# ═══════════════════════════════════════════════════════════════════════════════
# Gravel — single .env for all services
# Copy this file to .env and fill in the values.
# Apps automatically pick this file up from the monorepo root.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────────────────────────
# Dev:  SQLite (no server needed)
DATABASE_URL=sqlite+aiosqlite:///./gravel.db
# Prod: switch to Postgres
# DATABASE_URL=postgresql+asyncpg://gravel:gravel@localhost:5432/gravel

# ─── Redis (optional) ─────────────────────────────────────────────────────────
# Needed only for multi-worker WebSocket broadcasting. Leave blank for dev.
REDIS_URL=

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-use-a-random-32-byte-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Encryption ───────────────────────────────────────────────────────────────
# Fernet key for encrypting API keys + integration tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank in dev — a key is generated at startup (resets on restart).
ENCRYPTION_KEY=

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ─── API behaviour ────────────────────────────────────────────────────────────
SHOW_DOCS=true
DEBUG=false
UPLOAD_DIR=./uploads

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Database SSL (managed Postgres like Supabase) ───────────────────────────
# DATABASE_SSL=require

# ─── Engineer runtimes ────────────────────────────────────────────────────────
# docker = launch real containers (needs Docker socket); simulated = DB-only,
# the in-process executor does the work
RUNTIME_MODE=docker
RUNTIME_IMAGE=gravel-engineer:latest
# How runtime containers reach the API. In compose this is overridden to
# http://api:8000; for `make api` on the host keep host.docker.internal.
RUNTIME_API_BASE_URL=http://host.docker.internal:8000
RUNTIME_POLL_INTERVAL_SECONDS=15
RUNTIME_HEARTBEAT_INTERVAL_SECONDS=60

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to run without email: verification/reset links are
# logged to the API log instead of sent. Port 465 = SSL, otherwise STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Gravel <no-reply@gravel.dev>
SMTP_TLS=true
# Base URL of the web app — used to build verification/reset links
WEB_BASE_URL=http://localhost:3000

# ─── Git Integrations ─────────────────────────────────────────────────────────
# GitHub OAuth App — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitLab OAuth App — https://gitlab.com/-/user_settings/applications
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# Override for self-hosted GitLab:
GITLAB_BASE_URL=https://gitlab.com

# Bitbucket OAuth — https://bitbucket.org/account/settings/app-passwords/new
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=

# Gitea self-hosted (runs alongside Gravel if you want BYOG)
GITEA_BASE_URL=http://localhost:3001
GITEA_ADMIN_TOKEN=

# ─── Deployment Environments ──────────────────────────────────────────────────
# AWS (used for credential validation in the UI — users can also supply per-env)
AWS_DEFAULT_REGION=us-east-1

# GCP default project (optional helper — users supply service account per-env)
GCP_PROJECT_ID=

# Azure subscription (optional helper)
AZURE_SUBSCRIPTION_ID=
