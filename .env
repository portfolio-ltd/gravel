# ═══════════════════════════════════════════════════════════════════════════════
# Gravel — dev environment (single .env, loaded by both API and Web)
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./gravel.db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=

# ─── Auth ────────────────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-change-in-production-use-random-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Encryption ───────────────────────────────────────────────────────────────
ENCRYPTION_KEY=

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── API behaviour ────────────────────────────────────────────────────────────
SHOW_DOCS=true
DEBUG=true
UPLOAD_DIR=./uploads

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8001

# ─── Git Integrations ─────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_BASE_URL=https://gitlab.com
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=
GITEA_BASE_URL=http://localhost:3001
GITEA_ADMIN_TOKEN=

# ─── Deployment Environments ──────────────────────────────────────────────────
AWS_DEFAULT_REGION=us-east-1
GCP_PROJECT_ID=
AZURE_SUBSCRIPTION_ID=
